# Supabase project values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Mapbox token (starts with pk.). Restrict it to deployed domains.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Local UI preview only. Never enable this in a deployed environment.
DEMO_MODE=false
