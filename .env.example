# Supabase project values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for validated intake/Storage, staff administration and payment persistence.
# Prefer the hosted sb_secret_ key. The legacy/local service_role key also works.
SUPABASE_SECRET_KEY=

# Optional tile override. The app defaults to OpenStreetMap raster tiles.
# For higher production traffic, point this at your own OSM-compatible tile service.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Used only by the HMS address importer. Defaults to local Supabase when omitted.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local UI preview only. Never enable this in a deployed environment.
DEMO_MODE=false

# Optional exact origin for a temporary development/phone-test tunnel. Ignored in production.
ROAD_DEV_ORIGIN=

# Cloud API sending is paused by default; the dashboard prepares manual WhatsApp messages.
WHATSAPP_API_ENABLED=false

# myPOS existing Transactions REST API v1.1: merchant-issued credentials.
# Never prefix these names with NEXT_PUBLIC_. See docs/MYPOS_SETUP.md.
MYPOS_LEGACY_ENABLED=false
MYPOS_REST_ENV=sandbox
MYPOS_REST_CLIENT_ID=
MYPOS_REST_CLIENT_SECRET=
# Production request creation requires separate explicit approval/enablement.
MYPOS_LIVE_PAYMENTS_ENABLED=false
# Owner-confirmed fixed first charge: 10,490 ISK (whole ISK, without separators).
MYPOS_INITIAL_FEE_ISK=10490
# Enables customer checkout and dispatcher payment controls after migration.
MYPOS_COLLECTION_ENABLED=false
# Random server-only token, at least 32 characters, shared with the scheduler.
PAYMENT_WORKER_SECRET=
